# ==============================================================================
# DIGIHandover Backend — Environment Variables Configuration Template
# ==============================================================================

# Database Connection (MySQL / MariaDB via Prisma)
# Ganti dengan user, password, host, port, dan nama database target yang aman.
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@localhost:3306/handover_pertamina"

# Server Network Settings
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*

# ==============================================================================
# Authentication & Secret Tokens (CRITICAL SECURITY)
# ==============================================================================
# PENTING: DILARANG menggunakan nilai contoh di bawah ini pada staging/production!
# Sistem akan MENOLAK STARTUP jika secret ini kosong pada runtime non-test.
#
# Generate secret acak minimal 32 karakter (256-bit) dengan perintah terminal:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# atau menggunakan OpenSSL:
#   openssl rand -hex 32
#
# PERINGATAN ROTASI SECRET:
# Mengubah JWT_SECRET atau REFRESH_SECRET pada aplikasi yang sedang berjalan
# akan menyebabkan seluruh token yang telah diterbitkan menjadi tidak valid,
# sehingga seluruh pengguna akan logout otomatis. Jadwalkan rotasi secret di luar
# jam operasional sibuk dan komunikasikan kepada pengguna.
JWT_SECRET="GENERATE_STRONG_RANDOM_SECRET_MIN_32_CHARS_FOR_JWT"
REFRESH_SECRET="GENERATE_STRONG_RANDOM_SECRET_MIN_32_CHARS_FOR_REFRESH"

# Optional Cache & Multi-instance Session Store (Redis)
REDIS_URL=

# Super Admin Initial Bootstrap (Hanya digunakan saat bootstrap pertama kali)
# Setelah inisialisasi selesai, hapus atau kosongkan variabel ini demi keamanan.
SUPERADMIN_USERNAME=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=
SUPERADMIN_JABATAN=

# Email Notification Settings (SMTP Gmail / Server Relay)
ADMIN_EMAIL=admin@example.com
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_specific_password

# Reverse Geocoding API (Opsional: Google Maps Geocoding API Key)
# Jika tidak diisi, sistem otomatis menggunakan OpenStreetMap Nominatim secara gratis.
GOOGLE_GEOCODING_API_KEY=
