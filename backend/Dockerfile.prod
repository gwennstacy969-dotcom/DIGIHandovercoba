# ==============================================================
# Production Dockerfile for Pertamina HandoverApp Backend
# Multi-stage, Alpine-based, non-root secure container
# ==============================================================

# Stage 1: Build & Dependencies
FROM node:20-alpine AS builder

WORKDIR /app

# Install build tools for native C++ bindings (sharp, bcrypt)
RUN apk add --no-cache python3 make g++

COPY package*.json ./
COPY prisma ./prisma/

# Install dependencies including dev for generation/build
RUN npm ci

COPY . .

# Generate Prisma Client
RUN npx prisma generate

# Stage 2: Minimal Production Runner
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

# Install curl for container health check
RUN apk add --no-cache curl

# Copy compiled dependencies and source files from builder
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/src ./src
COPY --from=builder /app/index.js ./index.js

# Create required persistent storage folders and adjust permissions
RUN mkdir -p /app/uploads /app/barcodes /app/logs && \
    chown -R node:node /app

# Switch to non-root user
USER node

EXPOSE 3000

# Container healthcheck
HEALTHCHECK --interval=20s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -f http://localhost:3000/health || exit 1

# Start server directly without npm wrapper for clean signal propagation
CMD ["node", "index.js"]
