# ==============================================================
# Pertamina HandoverApp - Production Environment Configuration
# Save this file on VPS at: /var/www/handover-app/deploy/docker/.env
# Protect with: chmod 600 /var/www/handover-app/deploy/docker/.env
# ==============================================================

# Container Image Tag (Managed automatically by CI/CD)
BACKEND_IMAGE=ghcr.io/gwennstacy969-dotcom/handover-app/backend:latest

# MySQL Database Configuration
MYSQL_ROOT_PASSWORD=GantiDenganPasswordDatabaseSangatKuatDanPanjang2026!
MYSQL_DATABASE=handover_pertamina

# Authentication Tokens (Gunakan random string 64+ karakter)
# Generate dengan: openssl rand -hex 32
JWT_SECRET=GantiDenganRahasiaJwtProductionPertamina2026SangatRahasia
REFRESH_SECRET=GantiDenganRahasiaRefreshJwtProductionPertamina2026SangatRahasia

# Host Paths for Persistent Storage
UPLOADS_PATH=/var/www/handover-app/backend/uploads
BARCODES_PATH=/var/www/handover-app/backend/barcodes
LOGS_PATH=/var/www/handover-app/backend/logs

# Domain & CORS Whitelist
CORS_ORIGIN=https://pertamina-handover.com,https://www.pertamina-handover.com

# SMTP Email Configuration (Optional - for notifications/password reset)
ADMIN_EMAIL=admin.maos@pertamina.com
EMAIL_USER=notifikasi.pertamina@gmail.com
EMAIL_PASSWORD=app_specific_password_here
