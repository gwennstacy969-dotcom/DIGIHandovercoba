{
  "expo": {
    "name": "DIGI Handover",
    "slug": "DIGIHandover",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.pertamina.digihandover",
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0d1722",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Izinkan DIGI Handover untuk mengakses kamera untuk scan QR atau memotret."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Izinkan DIGI Handover mengakses lokasi Anda."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2aa65f6c-6739-40c6-8bc1-895689483618"
      }
    },
    "owner": "haulafatihas-team"
  }
}
